# Copy to .env on the production host and replace every placeholder.
PORT=8080
ENV=production
DEBUG=false
CORS_ORIGINS=https://app.example.com

POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
# The application connects with this dedicated login; the admin login is used
# only by the migration and role-bootstrap preflight services.
APP_DB_USER=sender_api_app
APP_DB_PASSWORD=replace-with-another-long-random-password
# Leave COMPOSE_DATABASE_URL empty to use the private Compose db service.
# For an external database, COMPOSE_DATABASE_URL uses the runtime role while
# MIGRATION_DATABASE_URL uses the separate schema-owner/admin role.
COMPOSE_DATABASE_URL=
MIGRATION_DATABASE_URL=
COMPOSE_REDIS_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
REDIS_POOL_SIZE=10

AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGSET=
OUTBOUND_SES_TOPIC_ARN=
# Keep false when OUTBOUND_SES_TOPIC_ARN is intentionally blank. Enable only
# after the SES configuration-set SNS destination and callback are verified.
REQUIRE_OUTBOUND_SES_EVENTS=false
PUBLIC_API_URL=https://chydo.lol
UNSUBSCRIBE_SIGNING_SECRET=replace-with-at-least-32-random-characters

SUPABASE_URL=https://project.supabase.co
METRICS_TOKEN=replace-with-a-long-random-metrics-token
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
DAILY_RECIPIENT_LIMIT=1000
PLAN_FREE_DAILY_LIMIT=1000
PLAN_PRO_DAILY_LIMIT=10000
PLAN_SCALE_DAILY_LIMIT=100000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_SUCCESS_URL=https://app.example.com/settings/billing?success=1
STRIPE_CANCEL_URL=https://app.example.com/settings/billing?cancelled=1
STRIPE_RETURN_URL=https://app.example.com/settings/billing

WORKER_POLL_INTERVAL=5s
INBOUND_SQS_VISIBILITY_TIMEOUT_SECONDS=120
EMAIL_RETENTION_DAYS=90
INBOUND_RETENTION_DAYS=30
WORKER_HEALTH_PORT=8090
INBOUND_S3_BUCKET=sender-api-inbound
INBOUND_SQS_QUEUE_URL=
INBOUND_SNS_TOPIC_ARN=
INBOUND_WEBHOOK_TOKEN=

NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-public-anon-key
