# Server
PORT=8080
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL; Supabase Database is optional)
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://supabase_admin:postgres@localhost:5432/sender_api
# Container Compose override; leave empty to use the local db service.
COMPOSE_DATABASE_URL=
# Low-volume defaults: keep idle connections and polling small.
DB_MAX_CONNS=4
DB_MIN_CONNS=0

# Redis
REDIS_URL=localhost:6379
# Container Compose override; leave empty to use the local redis service.
COMPOSE_REDIS_URL=
REDIS_POOL_SIZE=4

# AWS SES
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGSET=
OUTBOUND_SES_TOPIC_ARN=
REQUIRE_OUTBOUND_SES_EVENTS=false
PUBLIC_API_URL=
UNSUBSCRIBE_SIGNING_SECRET=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?cancelled=1
STRIPE_RETURN_URL=http://localhost:3000/settings/billing

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
SENTRY_DSN=
# Errors remain available when DSN is set; tracing is opt-in to avoid idle usage.
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_TOKEN=
DAILY_RECIPIENT_LIMIT=1000
PLAN_FREE_DAILY_LIMIT=1000
PLAN_PRO_DAILY_LIMIT=10000
PLAN_SCALE_DAILY_LIMIT=100000

# Workers
# Higher values reduce idle DB/Redis activity at the cost of delivery latency.
WORKER_POLL_INTERVAL=5s
INBOUND_SQS_VISIBILITY_TIMEOUT_SECONDS=120
EMAIL_RETENTION_DAYS=90
INBOUND_RETENTION_DAYS=30
WEB_MEM_LIMIT=256m
WEB_CPUS=0.25

# Inbound
# Optional production inbound adapter: SES -> SNS -> SQS -> S3 -> worker.
# The worker verifies SNS signatures and only deletes SQS messages after a DB write.
INBOUND_S3_BUCKET=sender-api-inbound
INBOUND_SQS_QUEUE_URL=
INBOUND_SNS_TOPIC_ARN=
# Set the SNS topic ARN only when the SQS inbound adapter is enabled. Leave it
# empty for outbound-only deployments to avoid unnecessary AWS integrations.
# Used only by the direct legacy/local raw-payload endpoint.
INBOUND_WEBHOOK_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
