# Server
PORT=8080
ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Database (Supabase)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sender_api

# Redis
REDIS_URL=localhost:6379

# AWS SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGSET=

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
SENTRY_DSN=

# Inbound
# Reserved for a future S3/SQS inbound ingestion adapter; not consumed yet.
INBOUND_S3_BUCKET=sender-api-inbound
INBOUND_SQS_QUEUE_URL=
INBOUND_WEBHOOK_TOKEN=

# Frontend
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
